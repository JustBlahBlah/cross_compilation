# clang-format — shared C++ style for the LPR project.
# Base: Google + 4-space indent + 100-column limit + `int* p` pointers.
# Apply: clang-format -i <files>  (or via your editor / CI). Needs clang-format 14+.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
ColumnLimit: 100
PointerAlignment: Left
DerivePointerAlignment: false
